# 아래 항목을 IDE 실행 환경 변수 또는 셸에 설정하세요. Spring Boot는 .env를 자동으로 읽지 않습니다.
KAKAO_CLIENT_ID=your-rest-api-key
KAKAO_CLIENT_SECRET=your-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback-page
# openssl rand -hex 32 등으로 생성한 32바이트 이상의 임의 문자열
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DB_URL=jdbc:mariadb://localhost:3306/aicare_yongin
DB_USERNAME=root
DB_PASSWORD=your-database-password
# 비어 있는 로컬 개발 DB의 최초 테이블 생성에만 update 사용. 기본값은 validate.
JPA_DDL_AUTO=update
# HTTPS 배포 환경에서는 true
SESSION_COOKIE_SECURE=false

# 최초 로그인 이후 Refresh Token 최대 유효기간
AUTH_REFRESH_TTL=14d

# 카카오 인증 완료 후 프론트 이동 주소. 카카오 콘솔의 백엔드 콜백 주소와 별개입니다.
AUTH_FRONTEND_SUCCESS_REDIRECT_URI=http://127.0.0.1:5173/home
# 선택: 별도 설정하지 않으면 위 주소의 origin을 CORS에 허용합니다.
# AUTH_FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
